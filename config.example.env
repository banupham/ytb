# Region to ask Invidious/YouTube for.
YTB_REGION=VN

# Optional. Leave unset for automatic discovery from the official Invidious directory.
# Pin this for repeatable research or when public instances disable the video API.
# YTB_INVIDIOUS_BASE=https://YOUR-INVIDIOUS-INSTANCE

# Optional override for the official directory JSON endpoint.
# YTB_INSTANCES_API=https://api.invidious.io/instances.json
